# Copy to .env and fill in. .env is git-ignored; never commit it.

# Optional compose profiles, comma separated: crm (Twenty CRM), tunnel (ngrok). Empty = just n8n + Postgres.
COMPOSE_PROFILES=

# --- n8n ---
# Pinned so the repo behaves the same for everyone. Latest stable: https://github.com/n8n-io/n8n/releases
N8N_VERSION=2.40.7
# Host port for the editor. Change if 5678 is taken.
N8N_PORT=5678
# Any long random string. Encrypts saved credentials; losing it makes them unreadable.
# Generate one with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me
# Shared secret between n8n and its task runner container. Generate with: openssl rand -hex 32
RUNNERS_AUTH_TOKEN=change-me
# Timezone for the instance. The weekly digest pins its own timezone (Asia/Kolkata) regardless.
GENERIC_TIMEZONE=Asia/Kolkata

# --- Postgres (holds n8n's own data and the failure_ledger table) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n

# --- Telegram alerts ---
# OPTIONAL. Bot token from @BotFather. If set, scripts/bootstrap.sh uses it once to create the
# n8n credential "Ops alerts (Telegram bot)"; it is never given to the n8n container or a workflow.
# Leave blank to paste the token into the n8n credential screen instead (README).
TELEGRAM_BOT_TOKEN=
# Your chat ID (see README, "Configure your own alerts"). Read by workflows as $env.TELEGRAM_CHAT_ID.
TELEGRAM_CHAT_ID=123456789

# --- Weekly digest -> Google Sheets (optional) ---
# "true" appends one row per digest to a Google Sheet. Needs a Google Sheets credential in n8n.
DIGEST_SHEETS_ENABLED=false
# The long ID in the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
DIGEST_SHEET_ID=

# --- Workflow 1: WhatsApp / web-form lead agent -------------------------------------------
# LLM: any OpenAI-compatible API. Default is Google Gemini's free tier.
# The key and base URL only create the n8n credential "LLM (OpenAI-compatible)"; n8n itself never sees them as env vars.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.1-flash-lite
# Used automatically when LLM_MODEL errors or times out (free tiers return 503 "high demand" at busy times).
LLM_FALLBACK_MODEL=gemma-4-26b-a4b-it
# Lead score (0-100) at or above which the owner gets a Telegram alert.
HOT_LEAD_SCORE=70
# Follow up once if a lead hasn't answered our reply after this many hours (decimals OK, e.g. 0.05 for testing).
FOLLOWUP_HOURS=4
# Messages from the same contact within this many minutes join the same conversation instead of creating a new lead.
DEDUPE_MINUTES=30

# CRM: Twenty (free, open source), started by COMPOSE_PROFILES=crm. false = Postgres only.
CRM_ENABLED=false
TWENTY_URL=http://twenty:2020
# Leave empty for the bundled demo image: bootstrap.sh uses the demo key Twenty publishes for it.
TWENTY_API_KEY=

# WhatsApp Cloud API (Meta). Leave empty to use only the web form.
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; you type the same value into Meta's webhook settings. openssl rand -hex 16
WHATSAPP_VERIFY_TOKEN=
# Meta app > App settings > Basic > App secret. Used to check X-Hub-Signature-256 on every webhook.
WHATSAPP_APP_SECRET=
# Optional: bootstrap.sh turns this into the n8n credential "WhatsApp Cloud API token".
WHATSAPP_ACCESS_TOKEN=

# Public URL (needed for WhatsApp only). With the ngrok profile: your free ngrok dev domain.
N8N_WEBHOOK_URL=
N8N_PROXY_HOPS=0
NGROK_AUTHTOKEN=
NGROK_URL=
