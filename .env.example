# Copy to .env and fill in. .env is git-ignored; never commit it.

# --- n8n ---
# Pinned so the repo behaves the same for everyone. Latest stable: https://github.com/n8n-io/n8n/releases
N8N_VERSION=2.40.7
# Host port for the editor. Change if 5678 is taken.
N8N_PORT=5678
# Any long random string. Encrypts saved credentials; losing it makes them unreadable.
# Generate one with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me
# Timezone for the instance. The weekly digest pins its own timezone (Asia/Kolkata) regardless.
GENERIC_TIMEZONE=Asia/Kolkata

# --- Postgres (holds n8n's own data and the failure_ledger table) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n

# --- Telegram alerts ---
# Bot token from @BotFather. Only used by scripts/bootstrap.sh to create the n8n credential;
# it is never passed to the n8n container and never appears in a workflow.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
# Your chat ID (see README, "Configure your own alerts"). Read by workflows as $env.TELEGRAM_CHAT_ID.
TELEGRAM_CHAT_ID=123456789

# --- Weekly digest -> Google Sheets (optional) ---
# "true" appends one row per digest to a Google Sheet. Needs a Google Sheets credential in n8n.
DIGEST_SHEETS_ENABLED=false
# The long ID in the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
DIGEST_SHEET_ID=
