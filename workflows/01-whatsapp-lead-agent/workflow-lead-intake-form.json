      "notes": "Web-form entry point: JSON { name, phone or email, message }.",
      "notesInFlow": true,
      "webhookId": "d4fde0f2-e5e9-408d-8f04-24ad33ed24f4"
    },
    {
      "parameters": {
        "jsCode": "// Checks the form body and normalises the contact: +<digits> for phones, lowercase for emails.\nconst b = $json.body ?? {};\nconst str = (v) => (typeof v === 'string' ? v.trim() : '');\nconst message = str(b.message).slice(0, 2000);\nconst raw = str(b.phone) || str(b.email);\nconst errors = [];\nlet contact = null;\nif (!message) errors.push('message is required');\nif (!raw) errors.push('phone or email is required');\nelse if (raw.includes('@')) {\n  contact = raw.toLowerCase();\n  if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(contact)) errors.push('email looks invalid');\n} else {\n  const digits = raw.replace(/\\D/g, '');\n  if (digits.length < 8 || digits.length > 15) errors.push('phone must have 8-15 digits, with country code');\n  contact = '+' + digits;\n}\nreturn [{ json: errors.length ? { valid: false, errors } : { valid: true, lead: {\n  source: 'form', contact, contact_name: str(b.name).slice(0, 120) || null, message,\n  received_at: new Date().toISOString(), external_id: null,\n} } }];"
      },
      "id": "2b6a4e2d-7e18-4ab2-879d-fed97ab56d82",
      "name": "Validate form",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "notes": "Requires a message and a phone (8-15 digits) or email; normalises the contact.",
      "notesInFlow": true
    },
