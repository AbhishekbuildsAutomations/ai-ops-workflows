        [
          {
            "node": "Worth syncing?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Worth syncing?": {
      "main": [
        [
          {
            "node": "Find person",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find person": {
      "main": [
        [
          {
            "node": "Pick matching person",
